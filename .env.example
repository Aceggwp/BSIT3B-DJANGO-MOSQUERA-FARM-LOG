# Copy this file to .env and fill in the values you need.
# .env is gitignored and loaded automatically by mysite/settings.py.
# Real environment variables take priority over .env.

# --- AI advice & harvest check (choose one provider) ---
# Default: Gemini. Get a free key at https://aistudio.google.com
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Alternative: OpenRouter. Get a key at https://openrouter.ai/keys
# AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# --- Weather ---
# Open-Meteo is the default and needs no key.
FARM_WEATHER_PROVIDER=open-meteo
FARM_WEATHER_CITY=Manila, PH
FARM_WEATHER_LAT=14.5995
FARM_WEATHER_LON=120.9842
FARM_RAIN_SKIP_MM=5.0
FARM_WEATHER_CACHE_SECONDS=1800

# Optional OpenWeatherMap instead of Open-Meteo
# FARM_WEATHER_PROVIDER=openweathermap
OPENWEATHER_API_KEY=
